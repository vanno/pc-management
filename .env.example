# MeshCentral : un compte dédié, membre des groupes du parc, avec le droit
# « exécuter des commandes ». Lu directement par meshctrl.
MESHCTRL_URL=wss://meshcentral.pointe-noire.com
MESHCTRL_LOGINUSER=pcm-worker
MESHCTRL_LOGINPASS=

# AVDiagram : jeton créé dans Profil > Jetons d'API par un membre qui a le
# droit parc:ecrire.
AVD_URL=https://avdiagram.vercel.app
AVD_TOKEN=avd_
