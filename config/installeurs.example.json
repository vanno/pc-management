{
  "installeurs": [
    {
      "nom": "vMix",
      "fichier": "vmix29.exe",
      "detection": "vMix*",
      "version": "",
      "arguments": "/VERYSILENT /SUPPRESSMSGBOXES /NORESTART"
    },
    {
      "nom": "Blackmagic ATEM Switchers",
      "fichier": "Blackmagic ATEM Switchers.msi",
      "detection": "Blackmagic ATEM Switchers*",
      "version": "",
      "arguments": ""
    },
    {
      "nom": "DaVinci Resolve",
      "fichier": "DaVinci_Resolve_Windows.exe",
      "detection": "DaVinci Resolve*",
      "version": "",
      "arguments": "/i /q /noreboot"
    },
    {
      "nom": "Microsoft 365",
      "fichier": "setup.exe",
      "detection": "Microsoft 365*",
      "version": "",
      "arguments": "/configure {configuration}",
      "configuration": "<Configuration><Add OfficeClientEdition=\"64\" Channel=\"Current\"><Product ID=\"O365BusinessRetail\"><Language ID=\"MatchOS\"/><ExcludeApp ID=\"Groove\"/><ExcludeApp ID=\"Lync\"/></Product></Add><Updates Enabled=\"TRUE\"/><RemoveMSI/><Display Level=\"None\" AcceptEULA=\"TRUE\"/></Configuration>"
    }
  ]
}
